---
import PixelIcon from './PixelIcon.astro';

const path = Astro.url.pathname;

const items = [
  { href: '/', icon: 'home', label: 'หน้าแรก' },
  { href: '/patch', icon: 'patch', label: 'แปะแพตช์' },
  { href: '/progress', icon: 'wip', label: 'กำลังทำ' },
  { href: '/report-bug', icon: 'bug', label: 'แจ้งบั๊ก' },
] as const;
---

<nav class="nav" aria-label="เมนูหลัก">
  {
    items.map((item) => (
      <a
        class="nav__item"
        href={item.href}
        aria-current={path === item.href ? 'page' : undefined}
      >
        <PixelIcon name={item.icon} class="nav__icon" />
        <span>{item.label}</span>
      </a>
    ))
  }
</nav>

<nav class="top-nav" aria-label="เมนูหลัก">
  <div class="top-nav__inner">
    <a class="top-nav__brand" href="/">เกมไทย</a>
    <div class="top-nav__links">
      {
        items.map((item) => (
          <a
            class="top-nav__link"
            href={item.href}
            aria-current={path === item.href ? 'page' : undefined}
          >
            <PixelIcon name={item.icon} class="top-nav__icon" />
            <span>{item.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>
