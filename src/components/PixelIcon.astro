---
interface Props {
  name: 'home' | 'patch' | 'wip' | 'bug' | 'heart';
  class?: string;
}

const { name, class: className } = Astro.props;

const ICONS: Record<string, string> = {
  home: `
    <rect x="3" y="0" width="2" height="1" fill="var(--clay)"/><rect x="2" y="1" width="4" height="1" fill="var(--clay)"/>
    <rect x="1" y="2" width="6" height="1" fill="var(--edge)"/><rect x="0" y="3" width="8" height="1" fill="var(--edge)"/>
    <rect x="0" y="4" width="3" height="1" fill="var(--amber)"/><rect x="3" y="4" width="2" height="1" fill="var(--blue)"/><rect x="5" y="4" width="3" height="1" fill="var(--amber)"/>
    <rect x="0" y="5" width="3" height="1" fill="var(--amber)"/><rect x="3" y="5" width="2" height="1" fill="var(--blue)"/><rect x="5" y="5" width="3" height="1" fill="var(--amber)"/>
    <rect x="0" y="6" width="3" height="1" fill="var(--amber)"/><rect x="3" y="6" width="2" height="1" fill="var(--blue)"/><rect x="5" y="6" width="3" height="1" fill="var(--amber)"/>
    <rect x="0" y="7" width="8" height="1" fill="var(--edge)"/>
  `,
  patch: `
    <rect x="2" y="0" width="4" height="1" fill="var(--amber)"/><rect x="1" y="1" width="6" height="1" fill="var(--amber)"/>
    <rect x="0" y="2" width="8" height="1" fill="var(--blue)"/><rect x="0" y="3" width="8" height="1" fill="var(--blue)"/>
    <rect x="0" y="4" width="8" height="1" fill="var(--blue)"/><rect x="0" y="5" width="8" height="1" fill="var(--blue)"/>
    <rect x="0" y="6" width="1" height="1" fill="var(--edge)"/><rect x="2" y="6" width="4" height="1" fill="var(--edge)"/><rect x="7" y="6" width="1" height="1" fill="var(--edge)"/>
    <rect x="0" y="7" width="1" height="1" fill="var(--edge)"/><rect x="2" y="7" width="4" height="1" fill="var(--edge)"/><rect x="7" y="7" width="1" height="1" fill="var(--edge)"/>
  `,
  wip: `
    <rect x="3" y="0" width="2" height="1" fill="var(--amber)"/>
    <rect x="1" y="1" width="2" height="1" fill="var(--amber)"/><rect x="3" y="1" width="2" height="1" fill="var(--clay)"/><rect x="5" y="1" width="2" height="1" fill="var(--amber)"/>
    <rect x="1" y="2" width="2" height="1" fill="var(--amber)"/><rect x="5" y="2" width="2" height="1" fill="var(--amber)"/>
    <rect x="0" y="3" width="8" height="1" fill="var(--amber)"/><rect x="0" y="4" width="8" height="1" fill="var(--amber)"/>
    <rect x="1" y="5" width="2" height="1" fill="var(--amber)"/><rect x="5" y="5" width="2" height="1" fill="var(--amber)"/>
    <rect x="1" y="6" width="2" height="1" fill="var(--amber)"/><rect x="3" y="6" width="2" height="1" fill="var(--clay)"/><rect x="5" y="6" width="2" height="1" fill="var(--amber)"/>
    <rect x="3" y="7" width="2" height="1" fill="var(--amber)"/>
  `,
  bug: `
    <rect x="2" y="0" width="1" height="1" fill="var(--edge)"/><rect x="5" y="0" width="1" height="1" fill="var(--edge)"/>
    <rect x="2" y="1" width="4" height="1" fill="var(--edge)"/>
    <rect x="1" y="2" width="6" height="1" fill="var(--clay)"/>
    <rect x="0" y="3" width="1" height="1" fill="var(--edge)"/><rect x="1" y="3" width="2" height="1" fill="var(--clay)"/><rect x="3" y="3" width="1" height="1" fill="var(--edge)"/><rect x="4" y="3" width="2" height="1" fill="var(--clay)"/><rect x="6" y="3" width="1" height="1" fill="var(--clay)"/><rect x="7" y="3" width="1" height="1" fill="var(--edge)"/>
    <rect x="0" y="4" width="1" height="1" fill="var(--edge)"/><rect x="1" y="4" width="2" height="1" fill="var(--clay)"/><rect x="3" y="4" width="1" height="1" fill="var(--clay)"/><rect x="4" y="4" width="1" height="1" fill="var(--edge)"/><rect x="5" y="4" width="2" height="1" fill="var(--clay)"/><rect x="7" y="4" width="1" height="1" fill="var(--edge)"/>
    <rect x="0" y="5" width="1" height="1" fill="var(--edge)"/><rect x="1" y="5" width="6" height="1" fill="var(--clay)"/><rect x="7" y="5" width="1" height="1" fill="var(--edge)"/>
    <rect x="1" y="6" width="6" height="1" fill="var(--clay)"/>
    <rect x="2" y="7" width="4" height="1" fill="var(--clay)"/>
  `,
  heart: `
    <rect x="1" y="0" width="2" height="1" fill="var(--clay)"/><rect x="5" y="0" width="2" height="1" fill="var(--clay)"/>
    <rect x="0" y="1" width="8" height="1" fill="var(--clay)"/>
    <rect x="0" y="2" width="8" height="1" fill="var(--clay)"/>
    <rect x="1" y="3" width="6" height="1" fill="var(--clay)"/>
    <rect x="2" y="4" width="4" height="1" fill="var(--clay-deep)"/>
    <rect x="3" y="5" width="2" height="1" fill="var(--clay-deep)"/>
  `,
};
---

<svg class={className} viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true" set:html={ICONS[name]} />
