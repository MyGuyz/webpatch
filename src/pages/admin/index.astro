---
import Base from '../../layouts/Base.astro';
import { getConsoles, isUsingSeedData } from '../../lib/games.js';

const consoles = await getConsoles();
const usingSeed = isUsingSeedData();

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

<Base title="จัดการเกม — เกมไทย" description="หน้าจัดการสำหรับผู้ดูแลเว็บ">
  <h1 class="page-head">จัดการเกม</h1>

  {
    usingSeed && (
      <p class="note">
        <strong>ยังไม่ได้เชื่อม Supabase</strong> — หน้านี้ใช้งานไม่ได้จนกว่าจะตั้งค่าตัวแปรใน
        Cloudflare แล้ว deploy ใหม่
      </p>
    )
  }

  <p class="msg" id="page-msg" hidden></p>

  <!-- ตอนโหลดหน้ายังไม่รู้ว่าล็อกอินอยู่หรือเปล่า จนกว่าจะถาม Supabase เสร็จ
       จึงซ่อนทั้งสองส่วนไว้ก่อน กันไม่ให้ฟอร์มล็อกอินแวบขึ้นมาให้คนที่ล็อกอินอยู่แล้วเห็น -->
  <section class="cart" id="signin" hidden>
    <div class="cart__label"><span>เข้าสู่ระบบ</span></div>
    <div class="cart__body">
      <form id="signin-form">
        <label class="field">
          <span class="field__label">อีเมล</span>
          <input type="email" id="email" autocomplete="username" required />
        </label>
        <label class="field">
          <span class="field__label">รหัสผ่าน</span>
          <input type="password" id="password" autocomplete="current-password" required />
        </label>
        <button class="btn btn--primary" type="submit" id="signin-btn">เข้าสู่ระบบ</button>
      </form>
      <p class="msg" id="signin-msg" hidden></p>
    </div>
  </section>

  <div id="workspace" hidden>
    <div class="whoami">
      <span class="muted" id="whoami-text"></span>
      <button class="btn btn--ghost btn--small" id="signout">ออกจากระบบ</button>
    </div>

    <p class="msg" id="list-msg" hidden></p>

    <div class="toolbar">
      <button class="btn btn--primary" id="add-btn">+ เพิ่มเกมใหม่</button>
      <a class="btn btn--ghost" href="/admin/bug-reports">🐛 รายงานบั๊ก</a>
    </div>

    <div id="game-list" class="stack"></div>
  </div>

  <p class="back"><a href="/">← กลับหน้าแรก</a></p>

  <template id="game-row">
    <article class="cart">
      <div class="cart__label">
        <span class="tag" data-status></span>
        <span class="tag tag--console" data-console></span>
      </div>
      <div class="cart__body">
        <h2 class="row__title" data-title></h2>
        <p class="muted mono" data-slug></p>
        <p class="muted" data-meta></p>
        <div class="row__actions">
          <button class="btn btn--ghost btn--small" data-edit>แก้ไข</button>
          <button class="btn btn--ghost btn--small" data-publish></button>
          <button class="btn btn--ghost btn--small btn--danger" data-delete>ลบ</button>
        </div>
      </div>
    </article>
  </template>

  <script
    is:inline
    data-astro-rerun
    define:vars={{ supabaseUrl, supabaseKey, consolesJson: JSON.stringify(consoles) }}
  >
    window.__SUPABASE__ = { url: supabaseUrl, key: supabaseKey };
    window.__CONSOLES__ = JSON.parse(consolesJson);
  </script>
  <script src="../../scripts/admin-list.js"></script>
</Base>

<style>
  .page-head {
    font-size: 1.7rem;
    margin: 20px 0 14px;
  }

  .whoami {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .toolbar {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .toolbar .btn {
    width: auto;
    flex: 1;
    min-width: 160px;
  }

  .row__title {
    font-size: 1.08rem;
  }

  .row__actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  .msg {
    padding: 11px 14px;
    border-radius: var(--radius-sm);
    border-left: 4px solid var(--clay);
    background: var(--clay-wash);
    font-size: 0.9rem;
    margin: 0 0 14px;
  }

  .msg[data-kind='ok'] {
    border-left-color: var(--teal);
    background: var(--teal-wash);
  }

  .back {
    margin: 24px 0;
  }
</style>
