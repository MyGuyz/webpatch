---
import Base from '../../layouts/Base.astro';
import { isUsingSeedData } from '../../lib/games.js';

const usingSeed = isUsingSeedData();

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

<Base title="รายงานบั๊ก — เกมไทย" description="หน้าจัดการสำหรับผู้ดูแลเว็บ">
  <h1 class="page-head">รายงานบั๊ก</h1>

  {
    usingSeed && (
      <p class="note">
        <strong>ยังไม่ได้เชื่อม Supabase</strong> — หน้านี้ใช้งานไม่ได้จนกว่าจะตั้งค่าตัวแปรใน
        Cloudflare แล้ว deploy ใหม่
      </p>
    )
  }

  <p class="msg" id="page-msg" hidden></p>

  <section class="cart" id="signin" hidden>
    <div class="cart__label"><span>เข้าสู่ระบบ</span></div>
    <div class="cart__body">
      <form id="signin-form">
        <label class="field">
          <span class="field__label">อีเมล</span>
          <input type="email" id="email" autocomplete="username" required />
        </label>
        <label class="field">
          <span class="field__label">รหัสผ่าน</span>
          <input type="password" id="password" autocomplete="current-password" required />
        </label>
        <button class="btn btn--primary" type="submit" id="signin-btn" data-sfx="confirm">เข้าสู่ระบบ</button>
      </form>
      <p class="msg" id="signin-msg" hidden></p>
    </div>
  </section>

  <div id="workspace" hidden>
    <div class="whoami">
      <span class="muted" id="whoami-text"></span>
      <button class="btn btn--ghost btn--small" id="signout" data-sfx="cancel">ออกจากระบบ</button>
    </div>

    <p class="msg" id="list-msg" hidden></p>

    <div class="filter-row">
      <label class="field field--inline">
        <span class="field__label">แสดงเฉพาะสถานะ</span>
        <select id="status-filter">
          <option value="">ทั้งหมด</option>
          <option value="new">ใหม่</option>
          <option value="triaged">รับเรื่องแล้ว</option>
          <option value="fixed">แก้แล้ว</option>
          <option value="wontfix">จะไม่แก้</option>
        </select>
      </label>
    </div>

    <div id="report-list" class="stack"></div>
  </div>

  <p class="back"><a href="/admin">← กลับไปจัดการเกม</a></p>

  <template id="report-row">
    <article class="cart">
      <div class="cart__label">
        <span class="tag" data-status></span>
        <span class="muted" data-date></span>
      </div>
      <div class="cart__body">
        <h2 class="row__title" data-title></h2>
        <p class="muted" data-meta></p>
        <p class="row__desc" data-desc></p>
        <p class="muted" data-extra hidden></p>
        <p class="muted" data-contact hidden></p>

        <div class="row__media" data-media></div>

        <div class="row__actions">
          <label class="field field--inline">
            <span class="field__label">สถานะ</span>
            <select data-status-select>
              <option value="new">ใหม่</option>
              <option value="triaged">รับเรื่องแล้ว</option>
              <option value="fixed">แก้แล้ว</option>
              <option value="wontfix">จะไม่แก้</option>
            </select>
          </label>
          <button type="button" class="btn btn--ghost btn--small btn--danger" data-delete>ลบ</button>
        </div>
      </div>
    </article>
  </template>

  <script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
    window.__SUPABASE__ = { url: supabaseUrl, key: supabaseKey };
  </script>
  <script src="../../scripts/admin-bug-reports.js"></script>
</Base>

<style>
  .page-head {
    font-size: 1.7rem;
    margin: 20px 0 14px;
  }

  .whoami {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .row__title {
    font-size: 1.08rem;
  }

  .row__desc {
    white-space: pre-line;
    margin: 8px 0 0;
  }

  .row__media {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 12px;
  }

  .row__actions {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    flex-wrap: wrap;
    align-items: flex-end;
  }

  .field--inline {
    width: auto;
  }

  .field--inline select {
    padding: 8px 10px;
    background: var(--surface);
    border: 2px solid var(--edge);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-family: inherit;
  }

  .filter-row {
    margin-bottom: 14px;
  }

  .msg {
    padding: 11px 14px;
    border-radius: var(--radius-sm);
    border-left: 4px solid var(--clay);
    background: var(--clay-wash);
    font-size: 0.9rem;
    margin: 0 0 14px;
  }

  .msg[data-kind='ok'] {
    border-left-color: var(--teal);
    background: var(--teal-wash);
  }

  .back {
    margin: 24px 0;
  }
</style>
