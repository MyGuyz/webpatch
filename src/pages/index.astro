---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import { getPublishedGames, getActiveAnnouncement, isUsingSeedData } from '../lib/games.js';

const games = await getPublishedGames();
const announcement = await getActiveAnnouncement();
const usingSeed = isUsingSeedData();

const ready = games.filter((g) => g.status === 'ready' || g.status === 'beta');
const inProgress = games.filter((g) => g.status === 'wip');
---

<Base title="เกมไทย — แพตช์แปลไทยสำหรับเกมย้อนยุค">
  <header class="hero cart">
    <div class="cart__label">
      <span>PATCH STATION</span>
    </div>
    <div class="hero__body">
      <h1 class="hero__title">เกมไทย</h1>
      <p class="hero__tag">เล่นเกมที่รักในภาษาที่เข้าใจ</p>
    </div>
  </header>

  <div class="stack">
    {
      usingSeed && (
        <p class="note">
          <strong>โหมดตัวอย่าง</strong> — ยังไม่ได้เชื่อม Supabase ข้อมูลที่เห็นเป็นของสมมติ
          <br />ไปตั้งค่าตัวแปร <span class="mono">PUBLIC_SUPABASE_URL</span> และ
          <span class="mono">PUBLIC_SUPABASE_ANON_KEY</span> ใน Cloudflare
          (ที่ <strong>Settings → Variables and Secrets</strong>) แล้ว deploy ใหม่
        </p>
      )
    }

    {
      announcement && (
        <section class="cart">
          <div class="cart__label"><span>ประกาศ</span></div>
          <div class="cart__body"><p class="announce">{announcement.body}</p></div>
        </section>
      )
    }

    <a class="btn btn--primary" href="/patch">🎮 เลือกเกมแล้วแปะแพตช์เลย</a>

    <section>
      <h2 class="section-head">ผลงานล่าสุด</h2>
      {
        ready.length === 0 ? (
          <p class="muted">ยังไม่มีเกมที่พร้อมให้แปะ รอติดตามนะครับ</p>
        ) : (
          <div class="stack">
            {ready.map((game) => (
              <GameCard game={game} href={`/patch?game=${game.id}`} />
            ))}
          </div>
        )
      }
    </section>

    {
      inProgress.length > 0 && (
        <section>
          <h2 class="section-head">กำลังแปลอยู่</h2>
          <div class="stack">
            {inProgress.map((game) => (
              <GameCard game={game} />
            ))}
          </div>
        </section>
      )
    }

    <p class="build-stamp muted">เว็บชุดนี้ build เมื่อ {__BUILD_TIME__}</p>

    <p class="note note--privacy">
      🔒 เว็บนี้แจกเฉพาะ<strong>ไฟล์แพตช์</strong> ไม่ได้แจกตัวเกม
      คุณต้องมีไฟล์เกมต้นฉบับของคุณเอง และไฟล์นั้นจะอยู่ในเครื่องคุณตลอด
      ไม่ถูกอัปโหลดขึ้นเซิร์ฟเวอร์
    </p>
  </div>
</Base>

<style>
  .hero {
    position: relative;
    margin: 18px 0 22px;
    background: linear-gradient(150deg, var(--clay-wash), var(--amber-wash));
    overflow: hidden;
  }

  /* วงแหวนเรืองแสงลาง ๆ ด้านหลังหัวเรื่อง ชวนให้นึกถึงแสงไฟตั้งโต๊ะยามเย็น */
  .hero::before {
    content: '';
    position: absolute;
    top: 46%;
    left: 50%;
    width: 280px;
    height: 280px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, var(--amber) 0%, transparent 68%);
    opacity: 0.4;
    filter: blur(18px);
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    top: 46%;
    left: 50%;
    width: 210px;
    height: 210px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 2px solid var(--amber);
    opacity: 0.3;
    pointer-events: none;
  }

  .hero__body {
    position: relative;
    z-index: 1;
    padding: 34px 20px 38px;
    text-align: center;
    /* เส้นสแกนจางๆ ให้ความรู้สึกจอ CRT */
    background-image: repeating-linear-gradient(
      180deg,
      rgba(58, 43, 33, 0.045) 0 2px,
      transparent 2px 5px
    );
  }

  .hero__title {
    font-size: 2.6rem;
    font-weight: 600;
    color: var(--clay-deep);
    letter-spacing: 0.02em;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.25);
  }

  .hero__tag {
    margin: 10px 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .section-head {
    font-size: 1.28rem;
    margin-bottom: 12px;
    padding-bottom: 7px;
    border-bottom: 3px dotted var(--edge);
  }

  .announce {
    margin: 0;
    font-size: 0.94rem;
  }

  .build-stamp {
    text-align: center;
    font-size: 0.75rem;
    opacity: 0.65;
  }
</style>
