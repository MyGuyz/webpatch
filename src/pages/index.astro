---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import PixelIcon from '../components/PixelIcon.astro';
import { getPublishedGames, getActiveAnnouncement, isUsingSeedData } from '../lib/games.js';

const games = await getPublishedGames();
const announcement = await getActiveAnnouncement();
const usingSeed = isUsingSeedData();

const ready = games.filter((g) => g.status === 'ready' || g.status === 'beta');
const inProgress = games.filter((g) => g.status === 'wip');
---

<Base title="เกมไทย — แพตช์แปลไทยสำหรับเกมย้อนยุค">
  <header class="hero cart">
    <div class="cart__label hero__strip">
      <span>◆ PATCH STATION</span>
      <span>เกมย้อนยุค</span>
    </div>
    <div class="hero__body">
      <div class="hero__text">
        <h1 class="hero__title">เกมไทย</h1>
        <p class="hero__tag">เล่นเกมที่รักในภาษาที่เข้าใจ</p>
        <a class="credit" href="https://www.facebook.com/maeepaew/" target="_blank" rel="noopener">
          <span class="credit__mark" aria-hidden="true">f</span>
          แปลโดยเพจ <strong>แมแปว</strong>
        </a>
      </div>
      <PixelIcon name="patch" class="hero__art" />
    </div>
  </header>

  <div class="stack">
    {
      usingSeed && (
        <p class="note">
          <strong>โหมดตัวอย่าง</strong> — ยังไม่ได้เชื่อม Supabase ข้อมูลที่เห็นเป็นของสมมติ
          <br />ไปตั้งค่าตัวแปร <span class="mono">PUBLIC_SUPABASE_URL</span> และ
          <span class="mono">PUBLIC_SUPABASE_ANON_KEY</span> ใน Cloudflare
          (ที่ <strong>Settings → Variables and Secrets</strong>) แล้ว deploy ใหม่
        </p>
      )
    }

    {
      announcement && (
        <section class="cart">
          <div class="cart__label"><span>ประกาศ</span></div>
          <div class="cart__body"><p class="announce">{announcement.body}</p></div>
        </section>
      )
    }

    <a class="btn btn--primary" href="/patch">🎮 เลือกเกมแล้วแปะแพตช์เลย</a>

    <section>
      <h2 class="section-head">ผลงานล่าสุด</h2>
      {
        ready.length === 0 ? (
          <p class="muted">ยังไม่มีเกมที่พร้อมให้แปะ รอติดตามนะครับ</p>
        ) : (
          <div class="games-grid">
            {ready.map((game) => (
              <GameCard game={game} href={`/patch?game=${game.id}`} />
            ))}
          </div>
        )
      }
    </section>

    {
      inProgress.length > 0 && (
        <section>
          <h2 class="section-head">กำลังแปลอยู่</h2>
          <div class="games-grid">
            {inProgress.map((game) => (
              <GameCard game={game} />
            ))}
          </div>
        </section>
      )
    }

    <section class="cart">
      <div class="cart__label" style="background: var(--blue); color: #fff8e8;">
        <span>◆ เกี่ยวกับทีม</span>
      </div>
      <div class="cart__body about">
        <div class="about__row">
          <span class="credit__mark about__mark" aria-hidden="true">f</span>
          <div>
            <p class="about__name">แมแปว</p>
            <p class="muted about__sub">เพจแปลเกมย้อนยุคภาษาไทย</p>
          </div>
        </div>
        <a class="btn btn--primary" href="https://www.facebook.com/maeepaew/" target="_blank" rel="noopener">
          👍 ติดตามเฟซบุ๊ก แมแปว
        </a>
      </div>
    </section>

    <p class="build-stamp muted">เว็บชุดนี้ build เมื่อ {__BUILD_TIME__}</p>

    <p class="note note--privacy">
      🔒 เว็บนี้แจกเฉพาะ<strong>ไฟล์แพตช์</strong> ไม่ได้แจกตัวเกม
      คุณต้องมีไฟล์เกมต้นฉบับของคุณเอง และไฟล์นั้นจะอยู่ในเครื่องคุณตลอด
      ไม่ถูกอัปโหลดขึ้นเซิร์ฟเวอร์
    </p>
  </div>
</Base>

<style>
  .hero {
    margin: 18px 0 22px;
  }

  .hero__strip {
    background: var(--clay);
    color: #fff8e8;
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    letter-spacing: 0.02em;
  }

  .hero__body {
    padding: 30px 20px 34px;
    text-align: center;
  }

  :global(.hero__art) {
    display: none;
  }

  @media (min-width: 720px) {
    .hero__body {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      text-align: left;
      padding: 36px 40px;
    }

    :global(.hero__art) {
      display: block;
      flex: none;
      width: 120px;
      height: 120px;
    }
  }

  .hero__title {
    font-size: 2.6rem;
    color: var(--ink);
    letter-spacing: 0.01em;
    text-shadow: 3px 3px 0 var(--amber);
  }

  .hero__tag {
    margin: 14px 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .credit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding: 7px 14px 7px 8px;
    border: 3px solid var(--edge);
    box-shadow: 3px 3px 0 var(--edge);
    background: var(--surface);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    transition: transform 0.05s ease, box-shadow 0.05s ease;
  }

  .credit:active {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--edge);
  }

  .credit strong {
    color: var(--ink);
  }

  .credit__mark {
    flex: none;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--blue);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    border: 2px solid var(--edge);
  }

  .section-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.15rem;
    margin-bottom: 12px;
  }

  .section-head::before {
    content: '';
    width: 12px;
    height: 12px;
    background: var(--clay);
    border: 2px solid var(--edge);
    flex: none;
  }

  .announce {
    margin: 0;
    font-size: 0.94rem;
  }

  .games-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (min-width: 700px) {
    .games-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  .about {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .about__row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .about__mark {
    width: 34px;
    height: 34px;
    font-size: 1.2rem;
  }

  .about__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .about__sub {
    margin: 2px 0 0;
  }

  .about .btn {
    width: auto;
  }

  .build-stamp {
    text-align: center;
    font-size: 0.75rem;
    opacity: 0.65;
  }
</style>
