---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import GameFilters from '../components/GameFilters.astro';
import { getPublishedGames, getConsoles, getActiveAnnouncement, isUsingSeedData } from '../lib/games.js';
import { readFilters, matchesGame, sortGames } from '../lib/game-filter.js';

const games = await getPublishedGames();
const consoles = await getConsoles();
const announcement = await getActiveAnnouncement();
const usingSeed = isUsingSeedData();

// หน้าแรกเป็นคลังเกม — ตัวกรองอ่านจากลิงก์ (/?console=ps2&q=...) ให้ลิงก์ที่แชร์มาขึ้นผล
// ที่กรองแล้วตั้งแต่แรก การ์ดทุกใบยังอยู่ในหน้า (ใบที่ไม่ตรงแค่ซ่อนไว้) สคริปต์จะได้กรองต่อ
// ในเครื่องผู้ใช้ทันทีโดยไม่ต้องโหลดหน้าใหม่ (ดู scripts/game-library.js)
const filters = readFilters(Astro.url.searchParams);
const sorted = sortGames(games, filters.sort);
const ready = sorted.filter((g) => g.status === 'ready' || g.status === 'beta');
const inProgress = sorted.filter((g) => g.status === 'wip');
const readyShown = ready.filter((g) => matchesGame(g, filters)).length;
const wipShown = inProgress.filter((g) => matchesGame(g, filters)).length;

// ข้อมูลเท่าที่ตัวกรองต้องใช้ ไม่ส่งทั้งก้อน
const libraryData = games.map((g) => ({
  id: g.id,
  title: g.title,
  subtitle: g.subtitle,
  status: g.status,
  patch_updated_at: g.patch_updated_at,
  download_count: g.download_count,
  console: g.console ? { name: g.console.name, slug: g.console.slug } : null,
}));
---

<Base title="แมแปว — แพตช์แปลไทยสำหรับเกมย้อนยุค">
  <header class="hero cart">
    <div class="cart__label hero__strip">
      <span>◆ เกมไทย</span>
      <span>เกมย้อนยุค</span>
    </div>
    <div class="hero__body">
      <picture class="hero__bg-pic">
        <source media="(min-width: 720px)" srcset="/img/hero-bg-desktop.jpg" />
        <img class="hero__bg" src="/img/hero-bg-mobile.jpg" alt="" />
      </picture>
      <div class="hero__text">
        <h1 class="hero__title">เกมไทย</h1>
        <p class="hero__tag">เล่นเกมที่รักในภาษาที่เข้าใจ</p>
        <a class="credit" href="https://www.facebook.com/maeepaew/" target="_blank" rel="noopener">
          <span class="credit__mark" aria-hidden="true">f</span>
          แปลโดยเพจ <strong>แมแปว</strong>
        </a>
        <div class="hero__bar" aria-hidden="true"><span></span></div>
        <span class="hero__prompt" aria-hidden="true">▶ PRESS START</span>
        <a class="btn btn--primary hero__cta" href="/patch" data-sfx="confirm">🕹️ เลือกเกมแล้วแปะแพตช์เลย</a>
      </div>
    </div>
  </header>

  <div class="stack">
    {
      usingSeed && (
        <p class="note">
          <strong>โหมดตัวอย่าง</strong> — ยังไม่ได้เชื่อม Supabase ข้อมูลที่เห็นเป็นของสมมติ
          <br />ไปตั้งค่าตัวแปร <span class="mono">PUBLIC_SUPABASE_URL</span> และ
          <span class="mono">PUBLIC_SUPABASE_ANON_KEY</span> ใน Cloudflare
          (ที่ <strong>Settings → Variables and Secrets</strong>) แล้ว deploy ใหม่
        </p>
      )
    }

    {
      announcement && (
        <section class="cart">
          <div class="cart__label"><span>ประกาศ</span></div>
          <div class="cart__body"><p class="announce">{announcement.body}</p></div>
        </section>
      )
    }

    <section id="library">
      <h2 class="section-head">
        เกมที่พร้อมให้แปะ
        <span class="muted section-head__count" data-library-count>
          {readyShown === ready.length ? `${ready.length} เกม` : `พบ ${readyShown} จาก ${ready.length} เกม`}
        </span>
      </h2>
      {
        games.length > 0 && (
          <GameFilters games={games} consoles={consoles} filters={filters} showSort />
        )
      }
      {
        ready.length === 0 ? (
          <p class="muted">ยังไม่มีเกมที่พร้อมให้แปะ รอติดตามนะครับ</p>
        ) : (
          <div class="games-grid" data-library-grid="ready">
            {ready.map((game) => (
              <div class="games-grid__cell" data-game-id={game.id} hidden={!matchesGame(game, filters)}>
                <GameCard game={game} href={`/patch?game=${game.id}`} />
              </div>
            ))}
          </div>
        )
      }
      <div class="library-empty" data-library-empty hidden={ready.length === 0 || readyShown > 0}>
        <p>ไม่พบเกมที่ตรงกับที่ค้นหา ลองพิมพ์ชื่ออื่น หรือเลือก “ทั้งหมด”</p>
        <button type="button" class="btn btn--small" data-filter-clear>ล้างตัวกรอง</button>
      </div>
    </section>

    {
      inProgress.length > 0 && (
        <section data-library-section="wip" hidden={wipShown === 0}>
          <h2 class="section-head">กำลังแปลอยู่</h2>
          <div class="games-grid" data-library-grid="wip">
            {inProgress.map((game) => (
              <div class="games-grid__cell" data-game-id={game.id} hidden={!matchesGame(game, filters)}>
                <GameCard game={game} />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <script type="application/json" id="library-data" set:html={JSON.stringify(libraryData)} />

    <section class="cart">
      <div class="cart__label" style="background: var(--blue); color: #fff8e8;">
        <span>◆ เกี่ยวกับทีม</span>
      </div>
      <div class="cart__body about">
        <div class="about__row">
          <span class="credit__mark about__mark" aria-hidden="true">f</span>
          <div>
            <p class="about__name">แมแปว</p>
            <p class="muted about__sub">เพจแปลเกมย้อนยุคภาษาไทย</p>
          </div>
        </div>
        <a class="btn btn--primary" href="https://www.facebook.com/maeepaew/" target="_blank" rel="noopener">
          👍 ติดตามเฟซบุ๊ก แมแปว
        </a>
      </div>
    </section>

    <p class="build-stamp muted">เว็บชุดนี้ build เมื่อ {__BUILD_TIME__}</p>

    <p class="note note--privacy">
      🔒 สิ่งที่แจกจากเว็บนี้มีแค่<strong>ไฟล์แพตช์</strong>อย่างเดียว ไม่มีตัวเกมให้โหลด
      ผู้เล่นต้องเตรียมไฟล์เกมต้นฉบับของตัวเองไว้ก่อน
      และไฟล์นั้นจะไม่ถูกส่งออกจากเครื่องไปไหนทั้งนั้น
    </p>
  </div>

  <script src="../scripts/game-library.js"></script>
</Base>

<style>
  .hero {
    margin: 18px 0 22px;
  }

  .hero__strip {
    background: var(--clay);
    color: #fff8e8;
    font-family: var(--font-pixel);
    font-size: 0.53rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
  }

  /* แถบนี้แต่ก่อนใช้ font-size หน่วย px ตายตัว เลยไม่โตตามจอใหญ่เหมือนจุดอื่นในเว็บ
     (จุดอื่นใช้ rem ซึ่งขยับตาม root font-size บนจอกว้างอัตโนมัติอยู่แล้ว)
     พอเปลี่ยนมาใช้ rem แล้ว ยังเพิ่มขนาด+ระยะขอบเองอีกชั้นให้เข้ากับแถบที่กว้างขึ้นบนจอใหญ่ */
  @media (min-width: 720px) {
    .hero__strip {
      font-size: 0.68rem;
      padding: 12px 20px;
    }
  }

  @media (min-width: 1200px) {
    .hero__strip {
      font-size: 0.78rem;
      padding: 14px 24px;
    }
  }

  /* พื้นหลังฉากเกมพิกเซล — เคยลองใช้ aspect-ratio เดาสัดส่วนภาพ + background-size:contain
     แต่ถ้าข้อความในกรอบสูงกว่าที่ aspect-ratio กำหนด กรอบจะขยายสูงกว่าภาพ แล้ว contain
     จะเห็นเป็นแถบพื้นหลังว่างๆ (letterbox) โผล่มาทั้งบน-ล่าง ไม่ใช่ "กรอบสูงเท่าภาพ" จริงๆ

     ลองแก้ต่อด้วยการเอารูปจริง (<img>) มาวางปกติ (height:auto) แล้ววางข้อความทับด้วย
     position:absolute — แต่พอเจอจอที่เตี้ยกว่าปกติมาก (มือถือแนวนอน หรือจอกว้างมากแต่
     เตี้ย) ข้อความสูงกว่ากรอบที่ล็อกตามภาพ กลายเป็นล้นทะลุกรอบไปเลย (เพราะ absolute
     ไม่ยอมให้กรอบขยายตาม) กับกรณีตรงข้ามที่ text ถูกบีบจนองค์ประกอบที่ไม่มีตัวหนังสือ
     อย่างหลอด .hero__bar ถูกบีบเหลือ 0 (มีแต่กรอบ ไม่มีสีข้างในเพราะสูงจนแทบเป็น 0)

     แก้จริงด้วย CSS Grid: วางรูปกับข้อความซ้อนกันในช่องเดียว (grid-area: 1 / 1) แล้วปล่อยให้
     "ความสูงของกรอบ" มาจากค่ามากสุดระหว่างความสูงตามสัดส่วนภาพ กับความสูงที่ข้อความต้องใช้จริง
     กรณีปกติ (ภาพสูงพออยู่แล้ว) กรอบจะสูงเท่าภาพพอดีเป๊ะเหมือนเดิม ไม่มีที่ว่างเหลือ
     กรณีจอเตี้ยผิดปกติที่ข้อความต้องการที่มากกว่าภาพ กรอบจะขยายตามข้อความแทน (ไม่ล้น
     ไม่บีบองค์ประกอบใดจนหาย) แล้วรูปจะยืด/ครอบตัดขอบเล็กน้อยด้วย object-fit:cover
     เพื่อเติมเต็มกรอบที่สูงขึ้นนั้นแทนที่จะเหลือช่องว่าง */
  .hero__body {
    display: grid;
  }

  .hero__bg-pic {
    display: contents;
  }

  .hero__bg {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__text {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px 20px 26px;
    text-align: center;
  }

  @media (min-width: 720px) {
    .hero__text {
      padding: 32px 40px;
      max-width: 640px;
      margin: 0 auto;
    }
  }

  @media (min-width: 1200px) {
    .hero__text {
      padding: 40px 56px;
      max-width: 720px;
    }
  }

  .hero__title {
    font-size: 2.6rem;
    color: var(--ink);
    letter-spacing: 0.01em;
    text-shadow: 3px 3px 0 var(--amber);
  }

  .hero__tag {
    margin: 14px 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  @media (min-width: 720px) {
    .hero__title {
      font-size: 3.4rem;
    }

    .hero__tag {
      font-size: 1.1rem;
    }
  }

  @media (min-width: 1200px) {
    .hero__title {
      font-size: 3.8rem;
    }

    .hero__tag {
      font-size: 1.2rem;
    }
  }

  /* แถบพลังงาน + ข้อความกระพริบ ให้ความรู้สึกหน้าจอ title screen ของเกมยุคเก่า
     เดิมทั้งคู่ล็อกขนาด px ตายตัวเล็กมาก (180x12 / 8px) เลยดูจิ๋วไม่สมกับกรอบ
     เปลี่ยนให้กว้างตามสัดส่วนของกรอบ (มี max-width กันยืดเกินบนจอกว้างมาก) และ
     ขยายขึ้นอีกชั้นตามช่วงจอ ให้เข้ากับความรู้สึก "หน้าจอรอกดเริ่มเกม" มากขึ้น */
  .hero__bar {
    margin: 22px auto 0;
    width: 70%;
    max-width: 230px;
    height: 15px;
    border: 2px solid var(--edge);
    background: var(--surface);
    padding: 2px;
  }

  .hero__bar span {
    display: block;
    height: 100%;
    width: 100%;
    background: repeating-linear-gradient(90deg, var(--teal) 0 6px, var(--teal-deep) 6px 7px);
  }

  .hero__prompt {
    display: block;
    margin-top: 12px;
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    color: var(--ink-soft);
    animation: blink 1.1s steps(1) infinite;
  }

  @media (min-width: 720px) {
    .hero__bar {
      max-width: 360px;
      height: 20px;
      margin-top: 28px;
    }

    .hero__prompt {
      font-size: 0.85rem;
      margin-top: 16px;
    }
  }

  @media (min-width: 1200px) {
    .hero__bar {
      max-width: 460px;
      height: 24px;
      margin-top: 32px;
    }

    .hero__prompt {
      font-size: 1rem;
      margin-top: 18px;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* ปุ่ม .btn ปกติกว้างเต็มบรรทัด แต่ปุ่มในหน้า title ต้องหดพอดีข้อความและอยู่กลาง */
  .hero__cta {
    display: inline-flex;
    width: auto;
    margin-top: 18px;
  }

  .credit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding: 7px 14px 7px 8px;
    border: 3px solid var(--edge);
    box-shadow: 3px 3px 0 var(--edge);
    background: var(--surface);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    transition: transform 0.05s ease, box-shadow 0.05s ease;
  }

  .credit:active {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--edge);
  }

  .credit strong {
    color: var(--ink);
  }

  .credit__mark {
    flex: none;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--blue);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    border: 2px solid var(--edge);
  }

  .section-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.15rem;
    margin-bottom: 12px;
  }

  .section-head::before {
    content: '';
    width: 12px;
    height: 12px;
    background: var(--clay);
    border: 2px solid var(--edge);
    flex: none;
  }

  .section-head__count {
    font-size: 0.82rem;
    font-weight: 400;
  }

  /* กล่องหุ้มการ์ดแต่ละใบไว้ซ่อน/สลับลำดับตอนกรอง — ต้องยืดเต็มช่องกริด การ์ดจะได้สูงเท่ากัน */
  /* min-width: 0 สำคัญ — ไม่งั้นช่องกริดจะกว้างตามป้ายที่ห้ามตัดบรรทัด (เช่นการ์ดที่มีป้าย NEW
     เพิ่มมา) จนการ์ดล้นคอลัมน์ไปซ้อนใบข้างๆ และปกใหญ่กว่าใบอื่น */
  .games-grid__cell {
    display: grid;
    min-width: 0;
  }

  .library-empty {
    padding: 18px;
    border: 2px dashed var(--edge);
    background: var(--surface);
    text-align: center;
  }

  .library-empty p {
    margin: 0 0 12px;
  }

  .library-empty .btn {
    margin: 0 auto;
  }

  .announce {
    margin: 0;
    font-size: 0.94rem;
  }

  .games-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* auto-fit ยุบคอลัมน์ที่ไม่มีการ์ดอยู่ให้เหลือ 0 แล้วดันการ์ดที่เหลือขยายเต็มแถวแทน
     กันช่องว่างเปล่าๆ เวลามีเกมพร้อมแปะไม่พอเติมเต็มทุกคอลัมน์บนจอกว้าง */
  @media (min-width: 700px) {
    .games-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 16px;
    }
  }

  @media (min-width: 1200px) {
    .games-grid {
      gap: 20px;
    }
  }

  .about {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .about__row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .about__mark {
    width: 34px;
    height: 34px;
    font-size: 1.2rem;
  }

  .about__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .about__sub {
    margin: 2px 0 0;
  }

  .about .btn {
    width: auto;
  }

  .build-stamp {
    text-align: center;
    font-size: 0.75rem;
    opacity: 0.65;
  }
</style>
