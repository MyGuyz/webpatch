---
import Base from '../layouts/Base.astro';
import { getPublishedGames, PROGRESS_STAGES, isUsingSeedData } from '../lib/games.js';

const games = await getPublishedGames();
const inProgress = games.filter((g) => g.status === 'wip');
const usingSeed = isUsingSeedData();

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

<Base title="กำลังทำอยู่ — เกมไทย" description="ดูความคืบหน้าของเกมที่กำลังแปลอยู่">
  <h1 class="page-head">กำลังทำอยู่</h1>
  <p class="muted lead">
    เกมที่ตัดสินใจลงมือแล้ว — ดูได้เลยว่าตอนนี้แต่ละเกมเดินมาถึงขั้นไหน
    พอครบทั้ง 5 ขั้นก็จะย้ายไปอยู่หน้าแปะแพตช์
  </p>

  {
    inProgress.length === 0 ? (
      <p class="muted">ตอนนี้ยังไม่มีเกมที่กำลังทำอยู่</p>
    ) : (
      <div class="stack">
        {inProgress.map((game) => (
          <article class="cart">
            <div class="cart__label">
              <span class="tag tag--wip">ขั้น {game.progress_stage}/5</span>
              <span class="tag tag--console">{game.console?.name ?? '—'}</span>
            </div>
            <div class="cart__body">
              <h2 class="title">{game.title}</h2>
              <p class="muted stage">{PROGRESS_STAGES[game.progress_stage - 1] ?? ''}</p>
              {game.description && <p class="desc">{game.description}</p>}

              <div class="bar" role="img" aria-label={`คืบหน้า ${game.progress_percent}%`}>
                <div class="bar__fill" style={`width:${game.progress_percent}%`}></div>
              </div>
              <p class="muted percent">งานแปล {game.progress_percent}%</p>
            </div>
          </article>
        ))}
      </div>
    )
  }

  <section class="requests">
    <h2 class="page-head requests__head">อยากให้แปลเกมไหนต่อ?</h2>
    <p class="muted lead">โหวตเกมที่อยากให้ทำ หรือแนะนำเกมใหม่ที่ยังไม่มีในลิสต์ได้เลย</p>

    {
      usingSeed && (
        <p class="note">
          <strong>ยังไม่ได้เชื่อม Supabase</strong> — โหวต/แนะนำเกมยังใช้ไม่ได้ในโหมดตัวอย่าง
        </p>
      )
    }

    <p class="msg" id="requests-msg" hidden></p>
    <div id="requests-list" class="stack"></div>

    {
      !usingSeed && (
        <form id="suggest-form" class="cart">
          <div class="cart__label"><span>แนะนำเกมใหม่</span></div>
          <div class="cart__body">
            <label class="field">
              <span class="field__label">ชื่อเกม *</span>
              <input type="text" name="title" placeholder="เช่น Suikoden II" required />
            </label>
            <label class="field">
              <span class="field__label">หมายเหตุ (ถ้ามี)</span>
              <input type="text" name="note" placeholder="เครื่องอะไร ทำไมอยากให้ทำ ฯลฯ" />
            </label>
            <label class="field field--trap" aria-hidden="true">
              <span class="field__label">เว้นว่างไว้</span>
              <input type="text" name="note_extra" tabindex="-1" autocomplete="off" />
            </label>
            <button class="btn btn--primary" type="submit" id="suggest-btn">+ แนะนำเกมนี้</button>
          </div>
        </form>
      )
    }
  </section>

  <script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
    window.__SUPABASE__ = { url: supabaseUrl, key: supabaseKey };
  </script>
  <script src="../scripts/progress-ui.js"></script>
</Base>

<style>
  .page-head { font-size: 1.7rem; margin: 20px 0 8px; }
  .lead { margin: 0 0 16px; }
  .title { font-size: 1.15rem; }
  .stage { margin: 2px 0 0; }
  .desc { font-size: 0.92rem; margin: 10px 0; }
  .bar {
    height: 10px;
    background: var(--surface-sunken);
    border: 2px solid var(--edge);
    border-radius: 999px;
    overflow: hidden;
    margin-top: 12px;
  }
  .bar__fill { height: 100%; background: var(--clay); }
  .percent { margin: 6px 0 0; }

  .requests { margin-top: 34px; }
  .requests__head { margin: 0 0 8px; }

  .request-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .request-row__title { font-size: 1.02rem; margin: 0; }
  .request-row__note { margin: 4px 0 0; }

  .vote-btn {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    width: 60px;
    padding: 8px 0;
    border: 2px solid var(--edge);
    border-radius: var(--radius-sm);
    background: var(--surface-sunken);
    color: var(--ink);
    font-family: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .vote-btn:active:not(:disabled) {
    transform: translateY(1px);
  }

  .vote-btn:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .vote-btn__count {
    font-size: 1.1rem;
  }

  .vote-btn__label {
    font-size: 0.68rem;
    color: var(--ink-soft);
  }

  #suggest-form {
    margin-top: 16px;
  }

  .field--trap {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    margin: 0;
    padding: 0;
  }

  .msg {
    padding: 11px 14px;
    border-radius: var(--radius-sm);
    border-left: 4px solid var(--clay);
    background: var(--clay-wash);
    font-size: 0.9rem;
    margin: 0 0 14px;
  }

  .msg[data-kind='ok'] {
    border-left-color: var(--teal);
    background: var(--teal-wash);
  }
</style>
