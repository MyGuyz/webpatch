---
import Base from '../layouts/Base.astro';
import PixelIcon from '../components/PixelIcon.astro';
import { getPublishedGames, PROGRESS_STAGES } from '../lib/games.js';

const games = await getPublishedGames();
const inProgress = games.filter((g) => g.status === 'wip');
---

<Base title="กำลังทำอยู่ — แมแปว" description="ดูความคืบหน้าของเกมที่กำลังแปลอยู่">
  <h1 class="page-head">กำลังทำอยู่</h1>
  <p class="muted lead">
    เกมที่กำลังแปลอยู่ตอนนี้ พร้อมบอกว่าถึงขั้นตอนไหนแล้วของทั้งหมด 5 ขั้น
    เสร็จเมื่อไหร่จะย้ายไปโผล่ในหน้าแปะแพตช์ทันที
  </p>

  {
    inProgress.length === 0 ? (
      <p class="muted">ตอนนี้ยังไม่มีเกมที่กำลังทำอยู่</p>
    ) : (
      <div class="stack">
        {inProgress.map((game) => (
          <article class="cart">
            <div class="cart__label">
              <span class="tag tag--wip">STAGE {game.progress_stage}/5</span>
              <span class="tag tag--console">{game.console?.name ?? '—'}</span>
            </div>
            <div class="cart__body">
              <div class="wip__cover">
                {
                  game.cover_url ? (
                    <img src={game.cover_url} alt={`ปกเกม ${game.title}`} loading="lazy" />
                  ) : (
                    <PixelIcon name="patch" class="wip__cover-art" />
                  )
                }
              </div>

              <h2 class="title">{game.title}</h2>
              <p class="muted stage">{PROGRESS_STAGES[game.progress_stage - 1] ?? ''}</p>
              {game.description && <p class="desc">{game.description}</p>}

              <div class="bar" role="img" aria-label={`คืบหน้า ${game.progress_percent}%`}>
                <div class="bar__fill" style={`width:${game.progress_percent}%`}></div>
              </div>
              <p class="muted percent">แปลไปแล้ว {game.progress_percent}%</p>
            </div>
          </article>
        ))}
      </div>
    )
  }
</Base>

<style>
  .page-head { font-size: 1.7rem; margin: 20px 0 8px; }
  .lead { margin: 0 0 16px; }
  .wip__cover {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    max-width: 160px;
    border: 2px solid var(--edge);
    background: var(--surface-sunken);
    margin: 0 0 12px;
    overflow: hidden;
  }
  .wip__cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .wip__cover :global(.wip__cover-art) { width: 30%; max-width: 48px; image-rendering: pixelated; }
  .title { font-size: 1.15rem; }
  .stage { margin: 2px 0 0; }
  .desc { font-size: 0.92rem; margin: 10px 0; }
  .bar {
    height: 10px;
    background: var(--surface-sunken);
    border: 2px solid var(--edge);
    border-radius: 999px;
    overflow: hidden;
    margin-top: 12px;
  }
  .bar__fill { height: 100%; background: var(--clay); }
  .percent { margin: 6px 0 0; }
</style>
