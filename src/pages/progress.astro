---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import { getPublishedGames } from '../lib/games.js';

const games = await getPublishedGames();
const inProgress = games.filter((g) => g.status === 'wip');
---

<Base title="กำลังทำอยู่ — แมแปว" description="ดูความคืบหน้าของเกมที่กำลังแปลอยู่">
  <h1 class="page-head">กำลังทำอยู่</h1>
  <p class="muted lead">
    เกมที่กำลังแปลอยู่ตอนนี้ พร้อมบอกว่าถึงขั้นตอนไหนแล้วของทั้งหมด 5 ขั้น
    เสร็จเมื่อไหร่จะย้ายไปโผล่ในหน้าแปะแพตช์ทันที
  </p>

  {
    inProgress.length === 0 ? (
      <p class="muted">ตอนนี้ยังไม่มีเกมที่กำลังทำอยู่</p>
    ) : (
      // การ์ดใช้ GameCard ตัวเดียวกับหน้าแรก ให้กรอบ/ขนาดภาพปกเหมือนกันทุกที่ในเว็บ
      <div class="games-grid">
        {inProgress.map((game) => (
          <GameCard game={game} />
        ))}
      </div>
    )
  }
</Base>

<style>
  .page-head {
    font-size: 1.7rem;
    margin: 20px 0 8px;
  }

  .lead {
    margin: 0 0 16px;
  }

  /* ค่าเดียวกับ .games-grid ในหน้าแรก (index.astro) — Astro scope สไตล์แยกไฟล์
     จึงต้องคัดลอกมาไว้ที่นี่ด้วย ไม่งั้นการ์ดจะไม่ได้ grid/ขนาดคอลัมน์แบบเดียวกัน */
  .games-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (min-width: 700px) {
    .games-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 16px;
    }
  }

  @media (min-width: 1200px) {
    .games-grid {
      gap: 20px;
    }
  }
</style>
