---
import Base from '../layouts/Base.astro';
import { getReadyGames, getConsoles, getVersionsByGame, isUsingSeedData } from '../lib/games.js';

const games = await getReadyGames();
const consoles = await getConsoles();
const versionsByGame = await getVersionsByGame(games);
const usingSeed = isUsingSeedData();

// เหลือเฉพาะเครื่องที่มีเกมพร้อมแปะจริง จะได้ไม่มีตัวเลือกที่กดแล้วว่างเปล่า (เหมือนหน้าแปะแพตช์)
const consolesWithGames = consoles.filter((c) => games.some((g) => g.console?.id === c.id));

const gamesForClient = games.map((g) => ({
  id: g.id,
  title: g.title,
  console: g.console ? { id: g.console.id, name: g.console.name } : null,
  versions: versionsByGame[g.id] ?? [],
}));
---

<Base title="แจ้งบั๊ก — แมแปว" description="เจอคำแปลผิดหรือเกมค้าง บอกเราได้ที่นี่">
  <h1 class="page-head">แจ้งบั๊ก</h1>
  <p class="muted lead">
    หน้านี้ไว้แจ้งจุดที่คำแปลดูแปลกๆ ฟอนต์เพี้ยน หรือเกมมีอาการค้างระหว่างเล่น
    กรอกรายละเอียดพร้อมแนบรูปหรือคลิปสั้นๆ อย่างน้อย 1 ไฟล์ จะได้ตามหาจุดที่พังได้เร็วขึ้น
  </p>

  {
    usingSeed && (
      <p class="note">
        <strong>ยังไม่ได้ตั้งค่า Supabase</strong> — หน้านี้ยังส่งรายงานไม่ได้
      </p>
    )
  }

  {
    !usingSeed && games.length === 0 && (
      <p class="muted">ยังไม่มีเกมที่พร้อมให้แปะในตอนนี้ เลยยังแจ้งบั๊กไม่ได้ครับ</p>
    )
  }

  <p class="msg" id="msg" hidden></p>

  {
    !usingSeed && games.length > 0 && (
      <form id="bug-form" class="stack">
        <section class="cart">
          <div class="cart__label"><span>1 · เกมและเวอร์ชัน</span></div>
          <div class="cart__body">
            <label class="field">
              <span class="field__label">เครื่องเล่น</span>
              <select id="console-select">
                <option value="">— ทุกเครื่อง —</option>
                {consolesWithGames.map((c) => (
                  <option value={c.id}>{c.name}</option>
                ))}
              </select>
            </label>

            <label class="field">
              <span class="field__label">เกม</span>
              <select name="game_id" id="game-select" required>
                <option value="">— เลือกเกม —</option>
              </select>
              <span class="err" data-err="game_id"></span>
            </label>

            <label class="field">
              <span class="field__label">เวอร์ชันแพตช์</span>
              <select name="patch_version" id="version-select" required disabled>
                <option value="">— เลือกเกมก่อน —</option>
              </select>
              <span class="err" data-err="patch_version"></span>
            </label>
          </div>
        </section>

        <section class="cart">
          <div class="cart__label"><span>2 · รายละเอียด</span></div>
          <div class="cart__body">
            <label class="field">
              <span class="field__label">อธิบายปัญหาที่เจอ *</span>
              <textarea name="description" rows="4" required></textarea>
              <span class="err" data-err="description"></span>
            </label>

            <label class="field">
              <span class="field__label">เจอตรงไหนของเกม (ถ้ารู้)</span>
              <input type="text" name="where_in_game" placeholder="เช่น บทที่ 3, ฉากเปิดเกม" />
            </label>

            <label class="field">
              <span class="field__label">ข้อความที่แปลผิด (ถ้ามี)</span>
              <textarea name="wrong_text" rows="2"></textarea>
            </label>

            <label class="field">
              <span class="field__label">โปรแกรมจำลองที่ใช้เล่น (ถ้ารู้)</span>
              <input type="text" name="emulator" placeholder="เช่น DuckStation, ePSXe" />
            </label>
          </div>
        </section>

        <section class="cart">
          <div class="cart__label"><span>3 · แนบรูปหรือวิดีโอ *</span></div>
          <div class="cart__body">
            <label class="field">
              <span class="field__label">เลือกไฟล์ (บังคับอย่างน้อย 1 ไฟล์)</span>
              <input type="file" id="media-input" accept="image/*,video/*" multiple required />
              <span class="err" data-err="media"></span>
            </label>
            <p class="muted">
              รูปภาพ: ไม่เกิน 15MB ต่อไฟล์ (ไฟล์ใหญ่ระบบย่อให้อัตโนมัติก่อนอัปโหลด) ·
              วิดีโอ: ไม่เกิน 30MB ต่อไฟล์
            </p>
            <p class="muted" id="media-summary"></p>
          </div>
        </section>

        <section class="cart">
          <div class="cart__label"><span>4 · ติดต่อกลับ (ถ้าต้องการ)</span></div>
          <div class="cart__body">
            <label class="field">
              <span class="field__label">อีเมลหรือ Discord (เผื่อเราอยากถามเพิ่ม)</span>
              <input type="text" name="contact" placeholder="เว้นว่างได้" />
            </label>

            <label class="field field--trap" aria-hidden="true">
              <span class="field__label">เว้นว่างไว้</span>
              <input type="text" name="note_extra" tabindex="-1" autocomplete="off" />
            </label>
          </div>
        </section>

        <button class="btn btn--primary" type="submit" id="submit-btn" data-sfx="none">ส่งรายงาน</button>

        <p class="muted spam-note">
          🛡️ ระบบจำกัดจำนวนครั้งที่ส่งได้ต่อเครือข่ายในช่วงเวลาสั้นๆ เพื่อกันสแปม
          ข้อมูลที่ใช้ตรวจเป็นรหัสสับ (hash) ของ IP เท่านั้น แปลงกลับเป็น IP จริงไม่ได้
        </p>
      </form>
    )
  }

  <script type="application/json" id="report-bug-data" set:html={JSON.stringify(gamesForClient)} />
  <script src="../scripts/report-bug-ui.js"></script>
</Base>

<style>
  .page-head {
    font-size: 1.7rem;
    margin: 20px 0 8px;
  }

  .lead {
    margin: 0 0 16px;
  }

  /* ฟอร์มขั้นตอนเดียวเหมือนหน้าแปะแพตช์ — จำกัดความกว้างบนจอกว้างมากๆ กันช่องกรอกยืดจนดูแปลก */
  @media (min-width: 1200px) {
    #bug-form {
      max-width: 640px;
      margin: 0 auto;
    }
  }

  .cart + .cart {
    margin-top: 16px;
  }

  textarea,
  input[type='text'] {
    width: 100%;
    padding: 12px 14px;
    background: var(--surface);
    border: 2px solid var(--edge);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-family: inherit;
    font-size: 1rem;
  }

  textarea {
    resize: vertical;
  }

  input[type='file'] {
    width: 100%;
    padding: 11px;
    background: var(--surface-sunken);
    border: 2px dashed var(--edge);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-family: inherit;
    font-size: 0.9rem;
  }

  #submit-btn {
    margin: 4px 0 10px;
  }

  .spam-note {
    margin: 0 0 28px;
    font-size: 0.8rem;
  }

  .field--trap {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    margin: 0;
    padding: 0;
  }

  .err {
    display: none;
    margin-top: 5px;
    font-size: 0.83rem;
    color: var(--danger);
  }

  .err:not(:empty) {
    display: block;
  }

  .msg {
    padding: 11px 14px;
    border-radius: var(--radius-sm);
    border-left: 4px solid var(--clay);
    background: var(--clay-wash);
    font-size: 0.9rem;
    margin: 0 0 14px;
  }

  .msg[data-kind='ok'] {
    border-left-color: var(--teal);
    background: var(--teal-wash);
  }
</style>
