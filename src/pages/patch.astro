---
import Base from '../layouts/Base.astro';
import PixelIcon from '../components/PixelIcon.astro';
import {
  getReadyGames,
  getConsoles,
  getChangelogsByGame,
  STATUS_LABELS,
  isUsingSeedData,
} from '../lib/games.js';

const games = await getReadyGames();
const consoles = await getConsoles();
const changelogsByGame = await getChangelogsByGame(games);
const usingSeed = isUsingSeedData();

const preselectedId = Astro.url.searchParams.get('game');

// เหลือเฉพาะเครื่องที่มีเกมพร้อมแปะจริง จะได้ไม่มีตัวเลือกที่กดแล้วว่างเปล่า
const consolesWithGames = consoles.filter((c) =>
  games.some((g) => g.console?.id === c.id)
);
---

<Base title="แปะแพตช์ภาษาไทย — เกมไทย" description="เลือกเกม เลือกไฟล์เกมของคุณ กดปุ่มเดียวได้เกมภาษาไทย">
  <h1 class="page-head">แปะแพตช์ภาษาไทย</h1>
  <p class="muted lead">
    หยิบไฟล์เกมต้นฉบับที่มีอยู่แล้วมาใส่ เลือกเกมที่ตรงกัน แล้วกดปุ่มเดียวจบ —
    ระบบแปะแพตช์ให้ในเบราว์เซอร์นี้เลย ไม่ต้องดาวน์โหลดโปรแกรมอะไรมาติดตั้งเพิ่ม
  </p>

  <p class="note note--privacy">
    🔒 ขั้นตอนแปะแพตช์ทั้งหมดเกิดขึ้นในเครื่องคุณเอง{' '}
    <strong>เว็บนี้ไม่มีการรับไฟล์เกมของคุณขึ้นมาเก็บที่เซิร์ฟเวอร์เลยแม้แต่ไบต์เดียว</strong>{' '}
    สิ่งเดียวที่แจกจากที่นี่คือไฟล์แพตช์เท่านั้น
  </p>

  {
    usingSeed && (
      <p class="note">
        <strong>โหมดตัวอย่าง</strong> — ยังไม่ได้เชื่อม Supabase
        เกมที่เห็นเป็นของสมมติและยังไม่มีไฟล์แพตช์จริง กดแปะจะขึ้นข้อความบอกว่ายังไม่มีไฟล์
      </p>
    )
  }

  {
    games.length === 0 ? (
      <p class="muted">ยังไม่มีเกมที่พร้อมให้แปะในตอนนี้ รอติดตามนะครับ</p>
    ) : (
      <div class="stack">
        <section class="cart">
          <div class="cart__label"><span>1 · เลือกเกม</span></div>
          <div class="cart__body">
            <label class="field">
              <span class="field__label">เครื่องเล่น</span>
              <select id="console-select">
                <option value="">— ทุกเครื่อง —</option>
                {consolesWithGames.map((c) => (
                  <option value={c.id}>{c.name}</option>
                ))}
              </select>
            </label>

            <label class="field">
              <span class="field__label">เกม</span>
              <select id="game-select">
                <option value="">— เลือกเกม —</option>
              </select>
            </label>
          </div>
        </section>

        <section class="cart" id="game-info" hidden>
          <div class="cart__label">
            <span id="info-status"></span>
            <span class="tag tag--console" id="info-console"></span>
          </div>
          <div class="cart__body">
            <h2 id="info-title" class="info__title"></h2>
            <p class="muted" id="info-version"></p>
            <p id="info-desc" class="info__desc"></p>

            <div class="spec">
              <span class="field__label">ไฟล์เกมต้นฉบับที่ต้องใช้</span>
              <p class="mono" id="info-spec"></p>
            </div>

            <details class="changelog" id="info-changelog" hidden>
              <summary>ประวัติการอัปเดต</summary>
              <div id="info-changelog-list"></div>
            </details>
          </div>
        </section>

        <section class="cart" id="step-file" hidden>
          <div class="cart__label"><span>2 · เลือกไฟล์เกมของคุณ</span></div>
          <div class="cart__body">
            <div class="field">
              <span class="field__label">ไฟล์เกมต้นฉบับ</span>
              <input class="sr-only-file" type="file" id="source-file" accept="application/octet-stream" />
              <label class="dropzone" for="source-file" id="dropzone-label">
                <span class="dropzone__icon" aria-hidden="true">📁</span>
                <span>กดเลือกไฟล์ของคุณ</span>
              </label>
            </div>
            <p class="muted mono" id="file-summary"></p>
          </div>
        </section>

        <div class="overlay" id="file-msgbox">
          <div class="msgbox msgbox--error overlay__card">
            <div class="msgbox__head">
              <span class="msgbox__icon">✕</span>
              <span>ไฟล์นี้ไม่ตรงกับที่แพตช์รองรับ</span>
              <button class="close-x" id="msgbox-close" type="button" aria-label="ปิด" data-sfx="none">X</button>
            </div>
            <div class="msgbox__body">
              <p>
                แพตช์แก้ไขข้อมูลในไฟล์ตามตำแหน่งที่ตายตัว ถ้าไฟล์ไม่ตรงกันแม้แต่ไบต์เดียว
                การแปะจะทำให้ไฟล์เกมพังจนเปิดเล่นไม่ได้ ระบบเลย<strong>ไม่ยอมให้กดแปะไฟล์นี้</strong>
                เพื่อกันไฟล์เกมของคุณเสีย
              </p>
              <details class="msgbox__why">
                <summary>▸ ทำไมถึงไม่ตรง?</summary>
                <ul>
                  <li>ไฟล์เป็นคนละภาค/ประเทศ (เช่น Japan แทน USA)</li>
                  <li>ไฟล์เคยถูกแพตช์หรือแก้ไขมาก่อนแล้ว</li>
                  <li>ไฟล์มี header แถมมา (พบบ่อยในบางเว็บที่แจกไฟล์ .smc/.nes)</li>
                  <li>ดาวน์โหลดมาจากคนละแหล่งที่ dump ไม่ตรงมาตรฐาน</li>
                </ul>
              </details>
              <div class="msgbox__todo">
                <p>ลองทำแบบนี้ดูครับ</p>
                <ul>
                  <li>เช็กชื่อไฟล์ต้นฉบับที่ต้องใช้ในกล่องข้อมูลเกมด้านบนอีกครั้ง</li>
                  <li>ลองหาไฟล์จากแหล่งอื่น (ต้องเป็นไฟล์ต้นฉบับที่ยังไม่ถูกแก้ไข)</li>
                  <li>ลองหลายรอบแล้วไม่ได้ ไปแจ้งบั๊กบอกเราได้เลย เดี๋ยวช่วยดูให้</li>
                </ul>
              </div>
              <div class="msgbox__actions">
                <button class="btn btn--small" type="button" id="msgbox-retry" data-sfx="none">🔁 เลือกไฟล์ใหม่</button>
              </div>
            </div>
          </div>
        </div>

        <div class="overlay" id="file-msgbox-zip">
          <div class="msgbox msgbox--warn overlay__card">
            <div class="msgbox__head">
              <span class="msgbox__icon">📦</span>
              <span>นี่คือไฟล์บีบอัด ยังไม่ใช่ไฟล์เกม</span>
              <button class="close-x" id="msgbox-zip-close" type="button" aria-label="ปิด" data-sfx="none">X</button>
            </div>
            <div class="msgbox__body">
              <p>
                ไฟล์ <code>.zip</code> / <code>.rar</code> / <code>.7z</code> ยังแปะไม่ได้ครับ ต้อง
                <strong>แตกไฟล์ (extract) ก่อน</strong> แล้วค่อยเลือกไฟล์เกมที่อยู่ข้างในมาแทน
              </p>
              <div class="msgbox__actions">
                <button class="btn btn--small" type="button" id="msgbox-zip-retry" data-sfx="none">🔁 เลือกไฟล์ใหม่</button>
              </div>
            </div>
          </div>
        </div>

        <div class="overlay" id="file-msgbox-ok">
          <div class="msgbox msgbox--ok overlay__card">
            <div class="msgbox__head">
              <span class="msgbox__icon">✓</span>
              <span>ไฟล์นี้ใช้ได้</span>
              <button class="close-x" id="msgbox-ok-close" type="button" aria-label="ปิด" data-sfx="none">X</button>
            </div>
            <div class="msgbox__body">
              <p>ไฟล์ตรงกับที่แพตช์รองรับพอดี กดปุ่มด้านล่างเพื่อแปะได้เลย</p>
              <p class="muted" id="patch-big-file-note" hidden>
                ไฟล์นี้ค่อนข้างใหญ่ อาจใช้เวลาสักพัก อย่าเพิ่งปิดแท็บระหว่างแปะนะครับ
              </p>
              <p class="msgbox__run-error" id="patch-run-error" hidden></p>
              <div class="msgbox__actions">
                <button class="btn btn--primary" id="apply-btn" type="button" data-sfx="none">✨ แปะแพตช์ภาษาไทย</button>
              </div>
            </div>
          </div>
        </div>

        <div class="overlay" id="patch-done-modal">
          <div class="cart overlay__card">
            <div class="cart__label" style="background: var(--teal); color: #f3fff0;">
              <span>✓ แปะแพตช์เสร็จแล้ว!</span>
              <button class="close-x" id="patch-done-close" type="button" aria-label="ปิด" data-sfx="none">X</button>
            </div>
            <div class="cart__body">
              <div class="patch-done__cover">
                <img id="patch-done-cover-img" alt="" hidden />
                <PixelIcon name="patch" class="patch-done__cover-art" />
              </div>
              <p class="patch-done__title" id="patch-done-title"></p>

              <div class="patch-done__guide">
                <h3>🎮 เปิดเล่นยังไง?</h3>
                <p class="muted">อ่านตรงนี้ก่อนไปเปิดเกมเล่น กันเปิดผิดไฟล์</p>

                <div class="stage">
                  <div class="stage__no">FILE</div>
                  <div class="stage__body">
                    <h4>ไฟล์ที่ได้คือ</h4>
                    <p class="mono" id="patch-done-filename"></p>
                    <p>สังเกตคำว่า <strong>_TH</strong> ต่อท้ายชื่อไฟล์เดิม — นี่คือไฟล์ภาษาไทยที่แปะเรียบร้อยแล้ว</p>
                  </div>
                </div>

                <div class="stage">
                  <div class="stage__no">STAGE<br />1</div>
                  <div class="stage__body">
                    <h4>ไฟล์อยู่ในเครื่องคุณแล้ว</h4>
                    <p>เบราว์เซอร์ดาวน์โหลดไฟล์นี้ให้อัตโนมัติ ปกติจะไปอยู่ในโฟลเดอร์ "Downloads" ของเครื่องคุณ</p>
                  </div>
                </div>

                <div class="stage">
                  <div class="stage__no">STAGE<br />2</div>
                  <div class="stage__body">
                    <h4>เปิดด้วยโปรแกรมเดิม</h4>
                    <p>ใช้โปรแกรมจำลองเครื่อง (emulator) ตัวเดียวกับที่คุณใช้เล่นเกมนี้อยู่แล้ว เปิดไฟล์ที่ดาวน์โหลดมา</p>
                  </div>
                </div>

                <div class="note" style="text-align: left;">
                  <p style="margin: 0 0 8px; font-weight: 600;">⚠ เปิดผิดไฟล์บ่อยที่สุด</p>
                  <p style="margin: 0;">
                    หลายคนเผลอไปเปิดไฟล์ต้นฉบับ (ไม่มี _TH) แล้วงงว่าทำไมยังเป็นภาษาอังกฤษอยู่ —
                    เช็คชื่อไฟล์ให้ชัวร์ก่อนเปิดเล่นนะครับ
                  </p>
                </div>
              </div>

              <button class="btn btn--primary" id="patch-done-done-btn" type="button" data-sfx="none">
                เข้าใจแล้ว เล่นได้เลย →
              </button>
            </div>
          </div>
        </div>

        <p class="note">
          ไฟล์ใหญ่ (แผ่น PS1/PSP) ใช้เวลาหลายนาทีและกินแรมเยอะ
          ระหว่างนั้นอย่าปิดแท็บ · เปิดบนคอมพิวเตอร์จะลื่นกว่ามือถือมาก
        </p>
      </div>
    )
  }

  <script
    type="application/json"
    id="patch-data"
    set:html={JSON.stringify({
      games: games.map((g) => ({ ...g, changelog: changelogsByGame[g.id] ?? [] })),
      preselectId: preselectedId,
    })}
  />
  <script src="../scripts/patch-ui.js"></script>
</Base>

<style>
  .page-head {
    font-size: 1.7rem;
    margin: 20px 0 8px;
  }

  .lead {
    margin: 0 0 16px;
  }

  /* หน้านี้เป็นฟอร์มขั้นตอนเดียว จอกว้างมากๆ ปล่อยให้ select/input ยืดเต็มจอแล้วดูแปลก
     เลยจำกัดความกว้างแล้ววางกลางจอแทน ให้ยังอ่านง่ายเหมือนฟอร์มทั่วไป */
  @media (min-width: 1200px) {
    .stack {
      max-width: 640px;
      margin: 0 auto;
    }
  }

  .info__title {
    font-size: 1.2rem;
  }

  .info__desc {
    font-size: 0.92rem;
    white-space: pre-line;
  }

  .spec {
    margin-top: 14px;
    padding: 11px 13px;
    background: var(--surface-sunken);
    border-radius: var(--radius-sm);
  }

  .spec p {
    margin: 4px 0 0;
  }

  .changelog {
    margin-top: 14px;
  }

  .changelog summary {
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .changelog-entry {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--edge);
  }

  .changelog-entry:first-child {
    margin-top: 12px;
  }

  .changelog-entry__head {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .changelog-entry__body {
    margin: 4px 0 0;
    font-size: 0.88rem;
    white-space: pre-line;
  }

  /* ซ่อน input[type=file] จริงไว้ (แต่ยังคลิกได้ผ่าน label for=) เพราะปุ่ม native
     "Choose File" ของแต่ละเบราว์เซอร์หน้าตาไม่เข้าธีมและปรับแต่งเองไม่ได้ */
  .sr-only-file {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .dropzone {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 22px;
    background: var(--surface-sunken);
    border: 2px dashed var(--edge);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.1s ease;
  }

  .dropzone:hover {
    background: var(--amber-wash);
  }

  .sr-only-file:focus-visible + .dropzone {
    outline: 3px solid var(--amber);
    outline-offset: 2px;
  }

  .dropzone__icon {
    font-size: 1.3rem;
  }

  #file-summary {
    margin-top: 10px;
  }

  #patch-big-file-note {
    margin: 10px 0 0;
  }

  .msgbox__run-error {
    margin: 10px 0 0;
    color: var(--danger);
    font-weight: 600;
  }

  .patch-done__guide {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 2px dotted var(--edge);
  }

  .patch-done__guide h3 {
    margin: 0 0 4px;
    font-size: 1.05rem;
  }

  .patch-done__guide > p.muted {
    margin: 0 0 14px;
  }

  .patch-done__guide .note {
    margin-top: 4px;
  }

  #patch-done-filename {
    margin: 2px 0 6px;
    word-break: break-all;
  }

  #patch-done-done-btn {
    margin-top: 16px;
  }

  .patch-done__cover {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border: 2px solid var(--edge);
    background: var(--surface-sunken);
    margin-bottom: 12px;
    overflow: hidden;
  }

  .patch-done__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .patch-done__cover :global(.patch-done__cover-art) {
    width: 30%;
    max-width: 64px;
    image-rendering: pixelated;
  }

  .patch-done__title {
    margin: 0 0 12px;
    font-weight: 600;
    text-align: center;
  }
</style>
