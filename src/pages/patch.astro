---
import Base from '../layouts/Base.astro';
import {
  getReadyGames,
  getConsoles,
  getChangelogsByGame,
  STATUS_LABELS,
  isUsingSeedData,
} from '../lib/games.js';

const games = await getReadyGames();
const consoles = await getConsoles();
const changelogsByGame = await getChangelogsByGame(games);
const usingSeed = isUsingSeedData();

const preselectedId = Astro.url.searchParams.get('game');

// เหลือเฉพาะเครื่องที่มีเกมพร้อมแปะจริง จะได้ไม่มีตัวเลือกที่กดแล้วว่างเปล่า
const consolesWithGames = consoles.filter((c) =>
  games.some((g) => g.console?.id === c.id)
);
---

<Base title="แปะแพตช์ภาษาไทย — เกมไทย" description="เลือกเกม เลือกไฟล์เกมของคุณ กดปุ่มเดียวได้เกมภาษาไทย">
  <h1 class="page-head">แปะแพตช์ภาษาไทย</h1>
  <p class="muted lead">
    หยิบไฟล์เกมต้นฉบับที่มีอยู่แล้วมาใส่ เลือกเกมที่ตรงกัน แล้วกดปุ่มเดียวจบ —
    ระบบแปะแพตช์ให้ในเบราว์เซอร์นี้เลย ไม่ต้องดาวน์โหลดโปรแกรมอะไรมาติดตั้งเพิ่ม
  </p>

  <p class="note note--privacy">
    🔒 ขั้นตอนแปะแพตช์ทั้งหมดเกิดขึ้นในเครื่องคุณเอง{' '}
    <strong>เว็บนี้ไม่มีการรับไฟล์เกมของคุณขึ้นมาเก็บที่เซิร์ฟเวอร์เลยแม้แต่ไบต์เดียว</strong>{' '}
    สิ่งเดียวที่แจกจากที่นี่คือไฟล์แพตช์เท่านั้น
  </p>

  {
    usingSeed && (
      <p class="note">
        <strong>โหมดตัวอย่าง</strong> — ยังไม่ได้เชื่อม Supabase
        เกมที่เห็นเป็นของสมมติและยังไม่มีไฟล์แพตช์จริง กดแปะจะขึ้นข้อความบอกว่ายังไม่มีไฟล์
      </p>
    )
  }

  {
    games.length === 0 ? (
      <p class="muted">ยังไม่มีเกมที่พร้อมให้แปะในตอนนี้ รอติดตามนะครับ</p>
    ) : (
      <div class="stack">
        <section class="cart">
          <div class="cart__label"><span>1 · เลือกเกม</span></div>
          <div class="cart__body">
            <label class="field">
              <span class="field__label">เครื่องเล่น</span>
              <select id="console-select">
                <option value="">— ทุกเครื่อง —</option>
                {consolesWithGames.map((c) => (
                  <option value={c.id}>{c.name}</option>
                ))}
              </select>
            </label>

            <label class="field">
              <span class="field__label">เกม</span>
              <select id="game-select">
                <option value="">— เลือกเกม —</option>
              </select>
            </label>
          </div>
        </section>

        <section class="cart" id="game-info" hidden>
          <div class="cart__label">
            <span id="info-status"></span>
            <span class="tag tag--console" id="info-console"></span>
          </div>
          <div class="cart__body">
            <h2 id="info-title" class="info__title"></h2>
            <p class="muted" id="info-version"></p>
            <p id="info-desc" class="info__desc"></p>

            <div class="spec">
              <span class="field__label">ไฟล์เกมต้นฉบับที่ต้องใช้</span>
              <p class="mono" id="info-spec"></p>
            </div>

            <details class="changelog" id="info-changelog" hidden>
              <summary>ประวัติการอัปเดต</summary>
              <div id="info-changelog-list"></div>
            </details>
          </div>
        </section>

        <section class="cart" id="step-file" hidden>
          <div class="cart__label"><span>2 · เลือกไฟล์เกมของคุณ</span></div>
          <div class="cart__body">
            <label class="field">
              <span class="field__label">ไฟล์เกมต้นฉบับ</span>
              <input type="file" id="source-file" accept="application/octet-stream" />
            </label>
            <p class="muted" id="file-summary"></p>
          </div>
        </section>

        <div class="overlay" id="file-msgbox">
          <div class="msgbox msgbox--error overlay__card">
            <div class="msgbox__head">
              <span class="msgbox__icon">✕</span>
              <span>ไฟล์นี้ไม่ตรงกับที่แพตช์รองรับ</span>
              <button class="close-x" id="msgbox-close" type="button" aria-label="ปิด">X</button>
            </div>
            <div class="msgbox__body">
              <p>
                แพตช์แก้ไขข้อมูลในไฟล์ตามตำแหน่งที่ตายตัว ถ้าไฟล์ไม่ตรงกันแม้แต่ไบต์เดียว
                การแปะจะทำให้ไฟล์เกมพังจนเปิดเล่นไม่ได้ ระบบเลย<strong>ไม่ยอมให้กดแปะไฟล์นี้</strong>
                เพื่อกันไฟล์เกมของคุณเสีย
              </p>
              <details class="msgbox__why">
                <summary>▸ ทำไมถึงไม่ตรง?</summary>
                <ul>
                  <li>ไฟล์เป็นคนละภาค/ประเทศ (เช่น Japan แทน USA)</li>
                  <li>ไฟล์เคยถูกแพตช์หรือแก้ไขมาก่อนแล้ว</li>
                  <li>ไฟล์มี header แถมมา (พบบ่อยในบางเว็บที่แจกไฟล์ .smc/.nes)</li>
                  <li>ดาวน์โหลดมาจากคนละแหล่งที่ dump ไม่ตรงมาตรฐาน</li>
                </ul>
              </details>
              <div class="msgbox__todo">
                <p>ลองทำแบบนี้ดูครับ</p>
                <ul>
                  <li>เช็กชื่อไฟล์ต้นฉบับที่ต้องใช้ในกล่องข้อมูลเกมด้านบนอีกครั้ง</li>
                  <li>ลองหาไฟล์จากแหล่งอื่น (ต้องเป็นไฟล์ต้นฉบับที่ยังไม่ถูกแก้ไข)</li>
                  <li>ลองหลายรอบแล้วไม่ได้ ไปแจ้งบั๊กบอกเราได้เลย เดี๋ยวช่วยดูให้</li>
                </ul>
              </div>
              <div class="msgbox__actions">
                <button class="btn btn--small" type="button" id="msgbox-retry">🔁 เลือกไฟล์ใหม่</button>
                <a class="btn btn--small btn--ghost" href="/report-bug">🐛 ไปหน้าแจ้งบั๊ก</a>
              </div>
            </div>
          </div>
        </div>

        <div class="overlay" id="file-msgbox-ok">
          <div class="msgbox msgbox--ok overlay__card">
            <div class="msgbox__head">
              <span class="msgbox__icon">✓</span>
              <span>ไฟล์นี้ใช้ได้</span>
              <button class="close-x" id="msgbox-ok-close" type="button" aria-label="ปิด">X</button>
            </div>
            <div class="msgbox__body">
              <p>ไฟล์ตรงกับที่แพตช์รองรับพอดี กดปุ่ม <strong>"✨ แปะแพตช์ภาษาไทย"</strong> ด้านล่างเพื่อแปะได้เลย</p>
              <div class="msgbox__actions">
                <button class="btn btn--small btn--primary" type="button" id="msgbox-ok-btn">✓ เข้าใจแล้ว</button>
              </div>
            </div>
          </div>
        </div>

        <section class="cart" id="step-run" hidden>
          <div class="cart__label"><span>3 · แปะแล้วดาวน์โหลด</span></div>
          <div class="cart__body stack">
            <button class="btn btn--primary" id="apply-btn" disabled>✨ แปะแพตช์ภาษาไทย</button>
            <button class="btn btn--ghost" id="download-btn" hidden>↓ ดาวน์โหลดไฟล์ภาษาไทย</button>
            <button class="btn btn--ghost" id="share-btn" hidden>🔗 แชร์ให้เพื่อน</button>
            <pre class="log" id="log" aria-live="polite"></pre>
          </div>
        </section>

        <p class="note">
          ไฟล์ใหญ่ (แผ่น PS1/PSP) ใช้เวลาหลายนาทีและกินแรมเยอะ
          ระหว่างนั้นอย่าปิดแท็บ · เปิดบนคอมพิวเตอร์จะลื่นกว่ามือถือมาก
        </p>
      </div>
    )
  }

  <script
    is:inline
    define:vars={{
      gamesJson: JSON.stringify(
        games.map((g) => ({ ...g, changelog: changelogsByGame[g.id] ?? [] }))
      ),
      preselectedId,
    }}
  >
    window.__GAMES__ = JSON.parse(gamesJson);
    window.__PRESELECT__ = preselectedId;
  </script>
  <script src="../scripts/patch-ui.js"></script>
</Base>

<style>
  .page-head {
    font-size: 1.7rem;
    margin: 20px 0 8px;
  }

  .lead {
    margin: 0 0 16px;
  }

  .info__title {
    font-size: 1.2rem;
  }

  .info__desc {
    font-size: 0.92rem;
    white-space: pre-line;
  }

  .spec {
    margin-top: 14px;
    padding: 11px 13px;
    background: var(--surface-sunken);
    border-radius: var(--radius-sm);
  }

  .spec p {
    margin: 4px 0 0;
  }

  .changelog {
    margin-top: 14px;
  }

  .changelog summary {
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .changelog-entry {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--edge);
  }

  .changelog-entry:first-child {
    margin-top: 12px;
  }

  .changelog-entry__head {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .changelog-entry__body {
    margin: 4px 0 0;
    font-size: 0.88rem;
    white-space: pre-line;
  }

  input[type='file'] {
    width: 100%;
    padding: 11px;
    background: var(--surface-sunken);
    border: 2px dashed var(--edge);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-family: inherit;
    font-size: 0.9rem;
  }
</style>
